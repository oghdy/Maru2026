    {
      "step_type": "intro",
      "title": "Grammar: 이에요 / 예요",
      "instruction": "이에요 and 예요 mean 'am/is/are'. They are attached directly to the noun.",
      "content": {
        "explanation": {
          "title": "Consonant vs Vowel ending"
        },
        "sentences": [
          {
            "korean": "학생이에요",
            "english": "학생 (ends with consonant ㅇ) + 이에요",
            "tts": false,
            "chunks": [
              {
                "display": "학생이에요",
                "tokens": [
                  {
                    "text": "학생",
                    "meaning": "student"
                  },
                  {
                    "text": "이에요",
                    "meaning": "am/is/are (polite)"
                  }
                ]
              }
            ]
          },
          {
            "korean": "의사예요",
            "english": "의사 (ends with vowel ㅏ) + 예요",
            "tts": false,
            "chunks": [
              {
                "display": "의사예요",
                "tokens": [
                  {
                    "text": "의사",
                    "meaning": "doctor"
                  },
                  {
                    "text": "예요",
                    "meaning": "am/is/are (polite)"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "step_type": "practice",
      "title": "Practice",
      "instruction": "Choose the correct ending for the job.",
      "content": {
        "exercises": [
          {
            "type": "fill_blank",
            "instruction": "I am a teacher.",
            "sentence": "저는 선생님 [ ? ].",
            "options": [
              "이에요",
              "예요"
            ],
            "answer": "이에요",
            "feedback": {
              "correct": "Correct! '선생님' ends with a consonant, so it takes '이에요'."
            }
          },
          {
            "type": "fill_blank",
            "instruction": "I am a doctor.",
            "sentence": "저는 의사 [ ? ].",
