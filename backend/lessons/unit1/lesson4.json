    {
      "step_type": "intro",
      "title": "Grammar: Unit 1 Review",
      "instruction": "Three things you learned in this unit. Each one depends on the last sound of the word.",
      "content": {
        "explanation": {
          "title": "Consonant vs Vowel ending",
          "patterns": [
            {
              "pattern": "은 / 는",
              "level": "Review",
              "usage": "It marks the topic. After a consonant use 은, after a vowel use 는."
            },
            {
              "pattern": "이에요 / 예요",
              "level": "Review",
              "usage": "It means 'am/is/are'. After a consonant use 이에요, after a vowel use 예요."
            },
            {
              "pattern": "을 / 를",
              "level": "Review",
              "usage": "It marks the object. After a consonant use 을, after a vowel use 를."
            }
          ]
        },
        "sentences": [
          {
            "korean": "저는 = I (topic)",
            "english": "저 (ends with vowel ㅓ) + 는",
