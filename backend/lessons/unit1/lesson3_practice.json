    {
      "step_type": "practice",
      "title": "Round 2: 을 or 를?",
      "instruction": "Look at the last sound of the word.",
      "content": {
        "exercises": [
          {
            "type": "fill_blank",
            "instruction": "I eat bread.",
            "sentence": "저는 빵 [ ? ] 먹어요.",
            "options": [
              "을",
              "를"
            ],
            "answer": "을",
            "feedback": {
              "correct": "Correct! 빵 ends in a consonant, so it takes 을."
            }
          },
