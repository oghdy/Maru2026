            "chunks": [
              {
                "display": "민수:",
                "tokens": [
                  {
                    "text": "민수",
                    "meaning": "Minsu (speaker)"
                  }
                ]
              },
              {
                "display": "안녕하세요?",
                "tokens": [
                  {
                    "text": "안녕하세요",
                    "meaning": "Hello"
                  }
                ]
              }
            ]
          },
          {
            "korean": "Sarah: 안녕하세요. 저는 Sarah입니다.",
            "english": "Sarah: Hello. I am Sarah.",
