    {
      "step_type": "intro",
      "title": "Grammar: Topic Particle 은/는",
      "instruction": "The most important concept in Korean grammar.",
      "content": {
        "explanation": {
          "title": "What is 는?",
          "patterns": [
            {
              "pattern": "는 / 은",
              "level": "Essential",
              "usage": "It marks the topic of the sentence."
            }
          ]
        },
        "sentences": [
          {
            "korean": "저는 = I (topic)",
            "english": "저 (I) + 는 (Topic Particle)",
            "tts": false,
            "chunks": [
              {
                "display": "저는",
                "tokens": [
                  {
                    "text": "저",
                    "meaning": "I (polite)"
                  },
                  {
                    "text": "는",
                    "meaning": "topic marker"
                  }
                ]
              },
              {
                "display": "=",
                "tokens": []
              },
              {
                "display": "I",
                "tokens": []
              },
              {
                "display": "(topic)",
                "tokens": []
              }
            ]
          },
          {
            "korean": "민수는 = Minsu (topic)",
            "english": "민수 (Minsu) + 는 (Topic Particle)",
            "tts": false,
            "chunks": [
              {
                "display": "민수는",
                "tokens": [
                  {
                    "text": "민수",
                    "meaning": "Minsu (name)"
                  },
                  {
                    "text": "는",
                    "meaning": "topic marker"
                  }
                ]
              },
              {
                "display": "=",
                "tokens": []
              },
              {
                "display": "Minsu",
                "tokens": []
              },
              {
                "display": "(topic)",
                "tokens": []
              }
            ]
          }
        ]
      }
    },
    {
      "step_type": "practice",
      "title": "Pattern Practice",
      "instruction": "See how it works with different names.",
      "content": {
        "exercises": [
          {
            "type": "fill_blank",
            "instruction": "I am Tom.",
            "sentence": "저 [ ? ] Tom입니다.",
            "options": [
              "은",
              "는"
            ],
            "answer": "는",
            "feedback": {
              "correct": "Correct! 저 + 는"
            }
          },
          {
            "type": "fill_blank",
            "instruction": "Minsu is a student.",
            "sentence": "민수 [ ? ] 학생입니다.",
            "options": [
              "은",
              "는"
            ],
            "answer": "는",
            "feedback": {
              "correct": "Great! 민수 + 는"
            }
          },
          {
            "type": "fill_blank",
            "instruction": "Emma is a teacher.",
            "sentence": "Emma [ ? ] 선생님입니다.",
            "options": [
              "은",
              "는"
            ],
            "answer": "는",
            "feedback": {
              "correct": "Perfect! Emma + 는"
            }
          },
          {
            "type": "fill_blank",
            "sentence": "제 이름 [ ? ] Tom입니다.",
            "options": [
              "은",
              "는"
            ],
            "answer": "은",
            "instruction": "My name is Tom.",
            "feedback": {
              "correct": "Right! 이름 ends in a consonant (ㅁ), so it takes 은."
            }
          }
        ]
      }
    },
    {
      "step_type": "practice",
      "title": "Make Your Own",
      "instruction": "Now it's your turn! Type your name.",
      "content": {
        "exercises": [
          {
            "type": "user_input",
            "instruction": "Complete the sentence with your name.",
            "template": "저는 {input}입니다.",
            "feedback": {
              "correct": "Great job! That's how you introduce yourself."
            }
          }
        ]
      }
    },
    {
