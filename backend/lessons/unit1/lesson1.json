    {
      "step_type": "intro",
      "title": "Grammar: Topic Particle 은/는",
      "instruction": "The most important concept in Korean grammar.",
      "content": {
        "explanation": {
          "title": "What is 는?",
          "patterns": [
            {
              "pattern": "는 / 은",
              "level": "Essential",
              "usage": "It marks the topic of the sentence."
            }
          ]
        },
        "sentences": [
          {
            "korean": "저는 = I (topic)",
            "english": "저 (I) + 는 (Topic Particle)",
            "tts": false,
            "chunks": [
              {
                "display": "저는",
                "tokens": [
                  {
                    "text": "저",
                    "meaning": "I (polite)"
                  },
                  {
                    "text": "는",
                    "meaning": "topic marker"
                  }
                ]
              },
              {
                "display": "=",
                "tokens": [
                  {
                    "text": "=",
                    "meaning": "word"
                  }
                ]
              },
              {
                "display": "I",
                "tokens": [
                  {
                    "text": "I",
                    "meaning": "word"
                  }
                ]
              },
              {
                "display": "(topic)",
                "tokens": [
                  {
                    "text": "(",
                    "meaning": "word"
                  },
                  {
                    "text": "topic",
                    "meaning": "word"
                  },
                  {
                    "text": ")",
                    "meaning": "word"
                  }
                ]
              }
            ]
          },
          {
            "korean": "민수는 = Minsu (topic)",
            "english": "민수 (Minsu) + 는 (Topic Particle)",
