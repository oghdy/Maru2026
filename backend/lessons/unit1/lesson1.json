{
  "steps": [
    {
      "step_type": "intro",
      "title": "Today's Goal",
      "instruction": "Let's learn how to introduce yourself and the major Korean particle '는'.",
      "content": {
        "explanation": {
          "title": "I am... (Introducing Yourself)"
        },
        "sentences": [
          {
            "korean": "안녕하세요! 제 이름은 Sarah예요.",
            "english": "Hello! My name is Sarah.",
            "tts": true,
            "chunks": [
              {
                "display": "안녕하세요!",
                "tokens": [
                  {
                    "text": "안녕하세요",
                    "meaning": "Hello"
                  }
                ]
              },
              {
                "display": "제",
                "tokens": [
                  {
                    "text": "저",
                    "meaning": "I (polite)"
                  },
                  {
                    "text": "의",
                    "meaning": "possessive marker"
                  }
                ]
              },
              {
                "display": "이름은",
                "tokens": [
                  {
                    "text": "이름",
                    "meaning": "name"
                  },
                  {
                    "text": "은",
                    "meaning": "topic marker"
                  }
                ]
              },
              {
                "display": "Sarah예요.",
                "tokens": [
                  {
                    "text": "Sarah",
                    "meaning": "Sarah (name)"
                  },
                  {
                    "text": "예요",
                    "meaning": "am/is/are (polite)"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "step_type": "intro",
      "title": "Conversation #1",
      "instruction": "Listen to the introduction between Sarah and Minsu.",
      "content": {
        "explanation": {
          "title": "Meeting for the first time"
        },
        "sentences": [
          {
            "korean": "민수: 안녕하세요?",
