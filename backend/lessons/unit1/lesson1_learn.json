{
  "steps": [
    {
      "step_type": "concept",
      "title": "A block you have seen",
      "instruction": "",
      "content": {
        "character": "turtle",
        "mood": "talking",
        "explanation": "You saw 는 in your first lesson. 저 means I, and 는 marks the topic.",
        "example": {
          "sentence": "저는 빵을 먹어요.",
          "translation": "I eat bread.",
          "tts": true,
          "words": [
            {
              "parts": [
                {
                  "text": "저",
                  "meaning": "I",
                  "highlight": false
                },
                {
                  "text": "는",
                  "meaning": "topic",
                  "highlight": true
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "빵을",
                  "meaning": "bread (object)",
                  "highlight": false
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "먹어요",
                  "meaning": "eat",
                  "highlight": false
                }
              ]
            }
          ]
        },
        "tap_to_assemble": true
      }
    },
    {
      "step_type": "concept",
      "title": "What is a topic?",
      "instruction": "",
      "content": {
        "character": "turtle",
        "mood": "happy",
        "explanation": "민수 and 유미 are names. The topic is who or what we're talking about.",
        "example": {
          "sentence": "민수는 빵을 먹어요.",
          "translation": "Minsu eats bread.",
          "tts": true,
          "words": [
            {
              "parts": [
                {
                  "text": "민수",
                  "meaning": "Minsu",
                  "highlight": false
                },
                {
                  "text": "는",
                  "meaning": "topic",
                  "highlight": true
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "빵을",
                  "meaning": "bread (object)",
                  "highlight": false
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "먹어요",
                  "meaning": "eat",
                  "highlight": false
                }
              ]
            }
          ]
        },
        "tap_to_assemble": true
      }
    },
    {
      "step_type": "practice",
      "title": "Quick check",
      "instruction": "No score here. Just try it.",
      "content": {
        "graded": false,
        "character": "turtle",
        "exercises": [
          {
            "type": "fill_blank",
            "instruction": "Yumi eats bread.",
            "sentence": "유미 [ ? ] 빵을 먹어요.",
            "options": [
              "을",
              "는"
            ],
            "answer": "는",
            "feedback": {
              "correct": "Yes! 유미 is the topic, so it takes 는.",
              "incorrect": "을 goes on the thing you eat. 유미 is who we're talking about, so use 는."
            }
          }
        ]
      }
    },
    {
      "step_type": "concept",
      "title": "Say who you are",
      "instruction": "",
      "content": {
        "character": "turtle",
        "mood": "talking",
        "explanation": "유미예요 means am Yumi. Keep it whole for now, and we'll open it next lesson.",
        "example": {
          "sentence": "저는 유미예요.",
          "translation": "I am Yumi.",
          "tts": true,
          "words": [
            {
              "parts": [
                {
                  "text": "저",
                  "meaning": "I",
                  "highlight": false
                },
                {
                  "text": "는",
                  "meaning": "topic",
                  "highlight": true
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "유미예요",
                  "meaning": "am Yumi",
                  "highlight": false
                }
              ]
            }
          ]
        },
        "tap_to_assemble": true
      }
    },
    {
      "step_type": "concept",
      "title": "Same block, new name",
      "instruction": "",
      "content": {
        "character": "turtle",
        "mood": "happy",
        "explanation": "저, 민수 and 유미 all end in a vowel. After a vowel, the block is 는.",
        "example": {
          "sentence": "저는 민수예요.",
          "translation": "I am Minsu.",
          "tts": true,
          "words": [
            {
              "parts": [
                {
                  "text": "저",
                  "meaning": "I",
                  "highlight": false
                },
                {
                  "text": "는",
                  "meaning": "topic",
                  "highlight": true
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "민수예요",
                  "meaning": "am Minsu",
                  "highlight": false
                }
              ]
            }
          ]
        },
        "tap_to_assemble": true
      }
    },
    {
      "step_type": "practice",
      "title": "Quick check",
      "instruction": "No score here. Just try it.",
      "content": {
        "graded": false,
        "character": "turtle",
        "exercises": [
          {
            "type": "fill_blank",
            "instruction": "I am Minsu.",
            "sentence": "저 [ ? ] 민수예요.",
            "options": [
              "는",
              "은"
            ],
            "answer": "는",
            "feedback": {
              "correct": "Right! 저 ends in a vowel, so it takes 는.",
              "incorrect": "저 ends in a vowel. After a vowel, use 는."
            }
          }
        ]
      }
    },
    {
      "step_type": "concept",
      "title": "Sometimes it is 은",
      "instruction": "",
      "content": {
        "character": "turtle",
        "mood": "thinking",
        "explanation": "제 means my, and 이름 means name. 이름 ends in a consonant, so the block is 은, not 는.",
        "example": {
          "sentence": "제 이름은 유미예요.",
          "translation": "My name is Yumi.",
          "tts": true,
          "words": [
            {
              "parts": [
                {
                  "text": "제",
                  "meaning": "my",
                  "highlight": false
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "이름",
                  "meaning": "name",
                  "highlight": false
                },
                {
                  "text": "은",
                  "meaning": "topic",
                  "highlight": true
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "유미예요",
                  "meaning": "is Yumi",
                  "highlight": false
                }
              ]
            }
          ]
        },
        "tap_to_assemble": true
      }
    },
    {
      "step_type": "concept",
      "title": "How to choose",
      "instruction": "",
      "content": {
        "character": "turtle",
        "mood": "talking",
        "explanation": "After a consonant, use 은, like 학생, student. After a vowel, use 는.",
        "example": {
          "sentence": "학생은 빵을 먹어요.",
          "translation": "The student eats bread.",
          "tts": true,
          "words": [
            {
              "parts": [
                {
                  "text": "학생",
                  "meaning": "student",
                  "highlight": false
                },
                {
                  "text": "은",
                  "meaning": "topic",
                  "highlight": true
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "빵을",
                  "meaning": "bread (object)",
                  "highlight": false
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "먹어요",
                  "meaning": "eat",
                  "highlight": false
                }
              ]
            }
          ]
        },
        "tap_to_assemble": true
      }
    },
    {
      "step_type": "practice",
      "title": "Quick check",
      "instruction": "No score here. Just try it.",
      "content": {
        "graded": false,
        "character": "turtle",
        "exercises": [
          {
            "type": "fill_blank",
            "instruction": "My name is Minsu.",
            "sentence": "제 이름 [ ? ] 민수예요.",
            "options": [
              "는",
              "은"
            ],
            "answer": "은",
            "feedback": {
              "correct": "Great! 이름 ends in a consonant, so it takes 은.",
              "incorrect": "이름 ends in a consonant. After a consonant, use 은."
            }
          }
        ]
      }
    },
    {
      "step_type": "completion",
      "title": "은/는 Learned!",
      "instruction": "Next, practice it with the rabbit.",
      "content": {
        "text": "은 and 는 mark the topic: who or what we're talking about.\nConsonant → 은 (이름은). Vowel → 는 (저는).",
        "highlights": [
          "은",
          "는"
        ]
      }
    }
  ]
}
