    {
      "step_type": "intro",
      "title": "Grammar: Place Particle 에",
      "instruction": "에 marks a place — where you go or where something is.",
      "content": {
        "explanation": {
          "title": "에 never changes",
          "patterns": [
            {
              "pattern": "에",
              "level": "Essential",
              "usage": "Put it after a place. It is the same after a consonant or a vowel."
            }
          ]
        },
