    {
      "step_type": "intro",
      "title": "Grammar: Unit 2 Review",
      "instruction": "Four things you learned in this unit.",
      "content": {
        "explanation": {
          "title": "이/가, 에, 에서, 안",
          "patterns": [
            {
              "pattern": "이 / 가",
              "level": "Review",
              "usage": "It marks what exists, before 있어요 or 없어요. After a consonant use 이, after a vowel use 가."
            },
            {
              "pattern": "에",
              "level": "Review",
              "usage": "It marks where you go or where you are."
            },
            {
              "pattern": "에서",
              "level": "Review",
              "usage": "It marks where you do something."
            },
            {
              "pattern": "안 + verb",
              "level": "Review",
              "usage": "It means 'not'. 안 goes right before the verb."
            }
          ]
        },
        "sentences": [
