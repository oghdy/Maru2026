    {
      "step_type": "practice",
      "title": "Round 2: 을 or 를?",
      "instruction": "안 changes nothing here. Look at the last sound of the word.",
      "content": {
        "exercises": [
          {
            "type": "fill_blank",
            "instruction": "I don't drink coffee.",
            "sentence": "저는 커피 [ ? ] 안 마셔요.",
            "options": [
              "을",
              "를"
            ],
            "answer": "를",
            "feedback": {
              "correct": "Correct! 커피 ends in a vowel, so it takes 를."
            }
          },
          {
            "type": "fill_blank",
            "instruction": "Minsu doesn't eat bread.",
            "sentence": "민수는 빵 [ ? ] 안 먹어요.",
