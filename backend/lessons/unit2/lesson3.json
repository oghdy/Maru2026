      "step_type": "intro",
      "title": "Grammar: Negation with 안",
      "instruction": "Put 안 right before the verb to say you don't do something.",
      "content": {
        "explanation": {
          "title": "안 + verb",
          "patterns": [
            {
              "pattern": "안 + verb",
              "level": "Essential",
              "usage": "It means 'not'. 안 goes right before the verb."
            }
          ]
        },
