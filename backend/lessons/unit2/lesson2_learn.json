    {
      "step_type": "concept",
      "title": "에 never changes",
      "instruction": "",
      "content": {
        "character": "turtle",
        "mood": "thinking",
        "explanation": "에 has one shape. Use it after a vowel or a consonant: 카페에, 집에.",
        "example": {
          "sentence": "민수는 카페에 있어요.",
          "translation": "Minsu is at a café.",
          "tts": true,
          "words": [
            {
              "parts": [
