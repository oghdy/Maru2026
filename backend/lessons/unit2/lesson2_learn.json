      "step_type": "concept",
      "title": "있어요 can also say where",
      "instruction": "",
      "content": {
        "character": "turtle",
        "mood": "talking",
        "explanation": "있어요 can also say where someone is. 집 means home.",
        "example": {
          "sentence": "저는 집에 있어요.",
          "translation": "I am at home.",
          "tts": true,
          "words": [
            {
              "parts": [
                {
                  "text": "저는",
                  "meaning": "I (topic)",
                  "highlight": false
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "집",
                  "meaning": "home",
                  "highlight": false
                },
                {
                  "text": "에",
                  "meaning": "place",
                  "highlight": false
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "있어요",
                  "meaning": "am at",
                  "highlight": true
                }
              ]
            }
          ]
        },
        "tap_to_assemble": true
      }
    },
    {
      "step_type": "concept",
      "title": "One block marks the place",
      "instruction": "",
      "content": {
        "character": "turtle",
        "mood": "happy",
        "explanation": "에 goes right after the place. It means at or to.",
        "example": {
          "sentence": "민수는 집에 있어요.",
          "translation": "Minsu is at home.",
          "tts": true,
          "words": [
            {
              "parts": [
                {
                  "text": "민수는",
                  "meaning": "Minsu (topic)",
                  "highlight": false
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "집",
                  "meaning": "home",
                  "highlight": false
                },
                {
                  "text": "에",
                  "meaning": "place",
                  "highlight": true
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "있어요",
                  "meaning": "is at",
                  "highlight": false
                }
              ]
            }
          ]
        },
        "tap_to_assemble": true
      }
    },
    {
      "step_type": "practice",
      "title": "Quick check",
      "instruction": "No score here. Just try it.",
