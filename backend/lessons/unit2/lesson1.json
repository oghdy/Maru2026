    {
      "step_type": "intro",
      "title": "Grammar: Subject Particle 이/가",
      "instruction": "이/가 marks the thing that exists — the thing you have or don't have.",
      "content": {
        "explanation": {
          "title": "Consonant vs Vowel ending",
          "patterns": [
            {
              "pattern": "이 / 가",
              "level": "Essential",
              "usage": "It marks what exists, before 있어요 or 없어요."
            }
          ]
        },
        "sentences": [
