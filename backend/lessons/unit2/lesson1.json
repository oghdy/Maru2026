    {
      "step_type": "intro",
      "title": "Today's Goal",
      "instruction": "Let's learn how to say what you have and don't have using 있어요 and 없어요.",
      "content": {
        "explanation": {
          "title": "I have ... / I don't have ..."
        },
        "sentences": [
          {
            "korean": "커피가 있어요.",
            "english": "There is coffee.",
            "tts": true,
            "chunks": [
              {
                "display": "커피가",
                "tokens": [
                  {
                    "text": "커피",
                    "meaning": "coffee"
                  },
                  {
                    "text": "가",
                    "meaning": "subject marker"
                  }
                ]
              },
              {
                "display": "있어요.",
                "tokens": [
                  {
                    "text": "있",
                    "meaning": "there is / have / be at"
                  },
                  {
                    "text": "어요",
                    "meaning": "polite ending"
                  }
                ]
              }
            ]
          },
          {
            "korean": "시간이 없어요.",
            "english": "I don't have time.",
            "tts": true,
            "chunks": [
              {
                "display": "시간이",
                "tokens": [
                  {
                    "text": "시간",
                    "meaning": "time"
                  },
                  {
                    "text": "이",
                    "meaning": "subject marker"
                  }
                ]
              },
              {
                "display": "없어요.",
                "tokens": [
                  {
                    "text": "없",
                    "meaning": "there isn't / don't have"
                  },
                  {
                    "text": "어요",
                    "meaning": "polite ending"
                  }
                ]
              }
            ]
          }
        ]
      }
