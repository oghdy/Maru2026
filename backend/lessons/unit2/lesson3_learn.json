          }
        ]
      }
    },
    {
      "step_type": "concept",
      "title": "No shape to choose",
      "instruction": "",
      "content": {
        "character": "turtle",
        "mood": "thinking",
        "explanation": "안 never changes shape. It is the same after a consonant or a vowel.",
        "example": {
          "sentence": "저는 물을 안 마셔요.",
          "translation": "I don't drink water.",
          "tts": true,
          "words": [
            {
              "parts": [
                {
                  "text": "저는",
                  "meaning": "I (topic)",
                  "highlight": false
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "물",
                  "meaning": "water",
                  "highlight": false
                },
                {
                  "text": "을",
                  "meaning": "object",
                  "highlight": false
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "안",
                  "meaning": "not",
                  "highlight": true
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "마셔요",
                  "meaning": "drink",
                  "highlight": false
                }
              ]
            }
          ]
        },
        "tap_to_assemble": true
      }
    },
    {
      "step_type": "concept",
      "title": "Other blocks stay",
      "instruction": "",
      "content": {
        "character": "turtle",
        "mood": "talking",
        "explanation": "안 doesn't change other blocks. 빵 still takes 을, and 커피 still takes 를.",
        "example": {
          "sentence": "민수는 빵을 안 먹어요.",
          "translation": "Minsu doesn't eat bread.",
          "tts": true,
          "words": [
            {
              "parts": [
                {
                  "text": "민수는",
                  "meaning": "Minsu (topic)",
                  "highlight": false
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "빵",
                  "meaning": "bread",
                  "highlight": false
                },
                {
                  "text": "을",
                  "meaning": "object",
                  "highlight": true
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "안",
                  "meaning": "not",
                  "highlight": true
                }
              ]
            },
            {
              "parts": [
                {
                  "text": "먹어요",
                  "meaning": "eat",
                  "highlight": false
                }
              ]
            }
          ]
        },
        "tap_to_assemble": true
      }
    },
    {
      "step_type": "practice",
      "title": "Quick check",
      "instruction": "No score here. Just try it.",
      "content": {
        "graded": false,
        "character": "turtle",
        "exercises": [
          {
            "type": "fill_blank",
            "instruction": "I don't drink coffee.",
            "sentence": "저는 커피 [ ? ] 안 마셔요.",
            "options": [
              "을",
              "를"
            ],
            "answer": "를",
            "feedback": {
              "correct": "Great! 커피 ends in a vowel, so it still takes 를.",
              "incorrect": "커피 ends in a vowel. After a vowel, use 를."
            }
          }
        ]
      }
    },
    {
      "step_type": "concept",
      "title": "How you'll practice",
