            "instruction": "Please read the book.",
            "sentence": "책을 [ ? ].",
            "options": [
              "읽으세요",
              "읽세요"
            ],
            "answer": "읽으세요",
            "feedback": {
              "correct": "Correct! 읽 ends in a consonant, so it takes 으세요."
            }
          },
          {
            "type": "fill_blank",
            "instruction": "Please sit here.",
            "sentence": "여기에 [ ? ].",
            "options": [
