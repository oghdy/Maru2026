      "step_type": "practice",
      "title": "Round 1: 아니에요 or 안?",
      "instruction": "Noun: 아니에요. Verb: 안. Which one fits?",
      "content": {
        "exercises": [
          {
            "type": "fill_blank",
            "instruction": "I am not a teacher.",
            "sentence": "저는 [ ? ].",
            "options": [
              "안 선생님이에요",
              "선생님이 아니에요"
            ],
            "answer": "선생님이 아니에요",
            "feedback": {
              "correct": "Correct! 선생님 is a noun, so use 이 아니에요, not 안."
            }
          },
          {
            "type": "fill_blank",
            "instruction": "I don't drink coffee.",
            "sentence": "저는 커피를 [ ? ].",
            "options": [
              "안 마셔요",
              "마셔요 아니에요"
            ],
            "answer": "안 마셔요",
            "feedback": {
              "correct": "Right! 마셔요 is a verb, so use 안."
            }
          },
