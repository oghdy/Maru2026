    {
      "step_type": "practice",
      "title": "Round 2: 았 or 었?",
      "instruction": "Look at the last vowel of the verb.",
      "content": {
        "exercises": [
          {
            "type": "fill_blank",
            "instruction": "I ate bread.",
            "sentence": "저는 빵을 [ ? ].",
            "options": [
              "먹었어요",
              "먹았어요"
            ],
            "answer": "먹었어요",
            "feedback": {
              "correct": "Correct! The vowel in 먹 is ㅓ, so + 었"
            }
          },
          {
            "type": "fill_blank",
            "instruction": "Yumi found her bag.",
            "sentence": "유미는 가방을 [ ? ].",
            "options": [
              "찾었어요",
              "찾았어요"
            ],
            "answer": "찾았어요",
            "feedback": {
              "correct": "Great! The vowel in 찾 is ㅏ, so + 았"
            }
          },
          {
            "type": "fill_blank",
            "instruction": "Minsu read a book.",
            "sentence": "민수는 책을 [ ? ].",
            "options": [
              "읽았어요",
              "읽었어요"
            ],
            "answer": "읽었어요",
            "feedback": {
              "correct": "Right! The vowel in 읽 is ㅣ, so + 었"
            }
          },
          {
            "type": "fill_blank",
            "instruction": "I sat in the café.",
            "sentence": "저는 카페에 [ ? ].",
            "options": [
              "앉았어요",
              "앉었어요"
            ],
            "answer": "앉았어요",
            "feedback": {
              "correct": "Perfect! The vowel in 앉 is ㅏ, so + 았"
            }
          },
          {
            "type": "fill_blank",
            "instruction": "Minsu received a book yesterday.",
            "sentence": "민수는 어제 책을 [ ? ].",
            "options": [
              "받었어요",
              "받았어요"
            ],
            "answer": "받았어요",
            "feedback": {
              "correct": "Correct! The vowel in 받 is ㅏ, so + 았"
            }
          },
          {
            "type": "fill_blank",
            "instruction": "Yumi was at home yesterday.",
            "sentence": "유미는 어제 집에 [ ? ].",
            "options": [
              "있었어요",
              "있았어요"
            ],
            "answer": "있었어요",
            "feedback": {
              "correct": "Right! The vowel in 있 is ㅣ, so + 었"
            }
          }
        ]
      }
