    {
      "step_type": "practice",
      "title": "Round 1: Spot the past",
      "instruction": "Is it now or the past? 어제 and 지금 are your clues.",
      "content": {
        "exercises": [
          {
            "type": "fill_blank",
            "instruction": "I ate bread yesterday.",
            "sentence": "저는 어제 빵을 [ ? ].",
            "options": [
              "먹어요",
              "먹었어요"
            ],
            "answer": "먹었어요",
            "feedback": {
              "correct": "Correct! 어제 means past, so 먹었어요."
            }
          },
          {
            "type": "fill_blank",
            "instruction": "Minsu read a book yesterday.",
            "sentence": "민수는 어제 책을 [ ? ].",
            "options": [
              "읽었어요",
              "읽어요"
            ],
            "answer": "읽었어요",
            "feedback": {
              "correct": "Right! 어제 means past, so 읽었어요."
            }
          },
          {
            "type": "fill_blank",
            "instruction": "Yumi was at home yesterday.",
            "sentence": "유미는 어제 집에 [ ? ].",
            "options": [
              "있어요",
              "있었어요"
            ],
            "answer": "있었어요",
            "feedback": {
              "correct": "Great! 어제 means past, so 있었어요."
            }
          },
          {
            "type": "fill_blank",
            "instruction": "Minsu is at home now.",
            "sentence": "민수는 지금 집에 [ ? ].",
            "options": [
              "있어요",
              "있었어요"
            ],
            "answer": "있어요",
            "feedback": {
              "correct": "Nice catch! 지금 means now, so 있어요."
            }
          },
          {
            "type": "fill_blank",
            "instruction": "I didn't have time yesterday.",
            "sentence": "저는 어제 시간이 [ ? ].",
            "options": [
              "없었어요",
              "없어요"
            ],
            "answer": "없었어요",
            "feedback": {
              "correct": "Perfect! 어제 means past, so 없었어요."
            }
          }
        ]
      }
