    {
      "step_type": "intro",
      "title": "Grammar: Past Tense 았/었",
      "instruction": "Add 았 or 었 to the verb to talk about the past. The last vowel of the verb decides which one.",
      "content": {
        "explanation": {
          "title": "ㅏ or ㅗ → 았, others → 었",
          "patterns": [
            {
              "pattern": "았 / 었 + 어요",
              "level": "Essential",
              "usage": "It marks the past. After ㅏ or ㅗ use 았, otherwise use 었."
            },
            {
              "pattern": "Verbs in this lesson",
              "level": "Note",
              "usage": "This lesson uses verbs that end in a consonant, like 먹. Verbs that end in a vowel, like 가요, change shape in the past. You will see them later."
            }
          ]
        },
        "sentences": [
          {
            "korean": "먹었어요 = ate",
            "english": "먹 (vowel ㅓ) + 었 + 어요",
            "tts": false,
