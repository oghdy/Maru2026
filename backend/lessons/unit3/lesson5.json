    {
      "step_type": "intro",
      "title": "Grammar: Unit 3 Review",
      "instruction": "Four things you learned in this unit.",
      "content": {
        "explanation": {
          "title": "아니에요, 았/었어요, 고 싶어요, (으)세요",
          "patterns": [
            {
              "pattern": "이 / 가 + 아니에요",
              "level": "Review",
              "usage": "It means 'am not / is not'. After a consonant use 이, after a vowel use 가."
            },
            {
              "pattern": "았 / 었 + 어요",
              "level": "Review",
              "usage": "It marks the past. After ㅏ or ㅗ use 았, otherwise use 었."
            },
            {
              "pattern": "verb + 고 싶어요",
              "level": "Review",
              "usage": "It means 'want to'."
            },
            {
              "pattern": "으세요 / 세요",
              "level": "Review",
              "usage": "It asks someone politely to do it. After a consonant use 으세요, after a vowel use 세요."
            }
          ]
        },
