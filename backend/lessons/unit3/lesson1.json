    {
      "step_type": "intro",
      "title": "Grammar: 이/가 아니에요",
      "instruction": "Use noun + 이/가 아니에요 to say what someone or something is not.",
      "content": {
        "explanation": {
          "title": "Consonant vs Vowel ending",
          "patterns": [
            {
              "pattern": "이 / 가 + 아니에요",
              "level": "Essential",
              "usage": "It means 'am not / is not'. After a consonant use 이, after a vowel use 가."
            },
            {
              "pattern": "안 + verb",
              "level": "Review",
              "usage": "안 goes before a verb. For a noun, use 이/가 아니에요."
            }
          ]
        },
        "sentences": [
          {
            "korean": "선생님이 아니에요 = am not a teacher",
